{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "Org.json",
    "type": "object",
    "properties": {
        "id": {
            "type": "string",
            "format": "uuid"
        },
        "slug": {
            "type": "string"
        },
        "name": {
            "type": "string"
        },
        "description": {
            "type": "string"
        },
        "settings": {
            "type": "string",
            "contentEncoding": "base64"
        },
        "createdByUserId": {
            "type": "string",
            "format": "uuid"
        },
        "isSoftDeleted": {
            "type": "boolean"
        },
        "createdAt": {
            "type": "string",
            "format": "date-time"
        },
        "updatedAt": {
            "type": "string",
            "format": "date-time"
        }
    },
    "required": [
        "id",
        "slug",
        "name",
        "settings",
        "isSoftDeleted",
        "createdAt",
        "updatedAt"
    ],
    "unevaluatedProperties": {
        "not": {}
    }
}