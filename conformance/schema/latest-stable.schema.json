{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zed-pkg.github.io/zed-lib-core/conformance/latest-stable.schema.json",
  "title": "zed-lib latest-stable conformance corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "description", "cases"],
  "properties": {
    "schema": {
      "const": "zed-lib/conformance/latest-stable/v1"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "scheme", "versions", "latest", "expect"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scheme": {
          "enum": ["semver", "calver", "opaque"]
        },
        "versions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "latest": {
          "type": ["string", "null"]
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version"],
          "properties": {
            "version": {
              "type": ["string", "null"]
            }
          }
        }
      }
    }
  }
}
