{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zed-pkg/zed-lock/protocol/formal-waiter-lifecycle.schema.json",
  "title": "zed-lock formal waiter lifecycle refinement corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "completion_cases",
    "terminal_event_cases",
    "lockset_unwind_cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "completion_cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/completion_case"
      }
    },
    "terminal_event_cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/terminal_event_case"
      }
    },
    "lockset_unwind_cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/lockset_unwind_case"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "identity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "completion_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "waiter_id",
        "receiver_alive",
        "native_granted",
        "expected_disposition"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "waiter_id": {
          "$ref": "#/$defs/identity"
        },
        "receiver_alive": {
          "type": "boolean"
        },
        "native_granted": {
          "const": true
        },
        "expected_disposition": {
          "enum": ["publish_result", "release_detached"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "receiver_alive": {
                "const": true
              }
            },
            "required": ["receiver_alive"]
          },
          "then": {
            "properties": {
              "expected_disposition": {
                "const": "publish_result"
              }
            }
          },
          "else": {
            "properties": {
              "expected_disposition": {
                "const": "release_detached"
              }
            }
          }
        }
      ]
    },
    "event": {
      "enum": [
        "Waiting",
        "Acquired",
        "Contended",
        "Released",
        "TimedOut",
        "Cancelled",
        "Failed"
      ]
    },
    "terminal_event_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reason", "expected_events", "forbidden_events"],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "reason": {
          "enum": ["timeout", "cancel"]
        },
        "expected_events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "forbidden_events": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reason": {
                "const": "timeout"
              }
            },
            "required": ["reason"]
          },
          "then": {
            "properties": {
              "expected_events": {
                "const": ["TimedOut"]
              },
              "forbidden_events": {
                "type": "array",
                "contains": {
                  "const": "Cancelled"
                }
              }
            }
          },
          "else": {
            "properties": {
              "expected_events": {
                "const": ["Cancelled"]
              },
              "forbidden_events": {
                "type": "array",
                "contains": {
                  "const": "TimedOut"
                }
              }
            }
          }
        }
      ]
    },
    "identity_sequence": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identity"
      }
    },
    "lockset_unwind_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "acquired_guard_ids", "expected_release_order"],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "acquired_guard_ids": {
          "$ref": "#/$defs/identity_sequence"
        },
        "expected_release_order": {
          "$ref": "#/$defs/identity_sequence"
        }
      }
    }
  }
}
